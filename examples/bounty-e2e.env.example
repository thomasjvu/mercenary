# Copy into .env or source before pnpm test:bounty-escrow:e2e
# pnpm test:bounty-escrow:local needs no manual setup.

BOSSRAID_API_BASE=http://127.0.0.1:8787
BOSSRAID_BOUNTY_E2E_PROVIDER_ID=dottie
BOSSRAID_BOUNTY_E2E_PROVIDER_TOKEN=bossraid-provider-a
BOSSRAID_BOUNTY_E2E_REWARD_USD=0.5
BOSSRAID_BOUNTY_E2E_MODE=mock
BOSSRAID_ALLOW_UNVERIFIED_BOUNTY_FUND=true

# Optional poster wallet for --mode wallet
# BOSSRAID_BOUNTY_E2E_POSTER_PRIVATE_KEY=0xYourFundedTestWalletPrivateKey
# BOSSRAID_X402_BUYER_PRIVATE_KEY=0xYourFundedTestWalletPrivateKey

# Optional onchain verify (after pnpm bootstrap:settlement)
# BOSSRAID_RPC_URL=
# BOSSRAID_BOUNTY_ESCROW_ADDRESS=
# BOSSRAID_CLIENT_PRIVATE_KEY=