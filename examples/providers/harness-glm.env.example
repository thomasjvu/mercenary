# GLM Coding Plan agent-harness worker (Z.ai OpenAI-compatible tools)
# Use the coding plan base URL so subscription quota is charged correctly.

BOSSRAID_PROVIDER_ID=harness-glm-fresh
BOSSRAID_PROVIDER_NAME=GLM harness (fresh)
BOSSRAID_PROVIDER_TOKEN=replace-with-provider-token
BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8787
PORT=9013

BOSSRAID_HARNESS_MODE=glm
BOSSRAID_HARNESS_SKILLS=
# BOSSRAID_HARNESS_IMAGE_DIGEST=sha256:...
BOSSRAID_HARNESS_MAX_STEPS=12

# Coding Plan OpenAI path (default when mode=glm)
BOSSRAID_MODEL_API_BASE=https://api.z.ai/api/coding/paas/v4
# Standard token API (not coding plan):
# BOSSRAID_MODEL_API_BASE=https://api.z.ai/api/paas/v4
BOSSRAID_MODEL_API_KEY=zai-...
BOSSRAID_MODEL=glm-4.7
BOSSRAID_AGENT_FRAMEWORK=glm
BOSSRAID_MODEL_PROVIDER=zai

# On Phala CVM:
# BOSSRAID_TEE_SOCKET_PATH=/var/run/dstack.sock
# BOSSRAID_PROVIDER_PRIVACY_FEATURES=tee_attested,signed_outputs,no_data_retention
