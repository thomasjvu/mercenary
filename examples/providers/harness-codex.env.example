# Codex agent-harness worker (OpenAI-compatible tool loop)
# Run on platform Phala (or local) as a Boss Raid HTTP provider.

BOSSRAID_PROVIDER_ID=harness-codex-fresh
BOSSRAID_PROVIDER_NAME=Codex harness (fresh)
BOSSRAID_PROVIDER_TOKEN=replace-with-provider-token
BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8787
PORT=9011

BOSSRAID_HARNESS_MODE=codex
# Empty skills = fresh install (buyers see installation=fresh)
BOSSRAID_HARNESS_SKILLS=
# Optional image digest from your published worker image
# BOSSRAID_HARNESS_IMAGE_DIGEST=sha256:...
# Specialized seats (skills set): pin digest + ops allowlist in production
# BOSSRAID_HARNESS_IMAGE_ALLOWLIST=sha256:...
# BOSSRAID_HARNESS_REQUIRE_IMAGE_ALLOWLIST=1
# Native Codex SDK/CLI (optional; default stays openai_tools loop)
# BOSSRAID_HARNESS_RUNTIME_BACKEND=auto
# BOSSRAID_HARNESS_NATIVE_SDK=0
# BOSSRAID_CODEX_CLI_BIN=codex
BOSSRAID_HARNESS_MAX_STEPS=12

BOSSRAID_MODEL_API_BASE=https://api.openai.com/v1
BOSSRAID_MODEL_API_KEY=sk-...
BOSSRAID_MODEL=gpt-5.5
BOSSRAID_AGENT_FRAMEWORK=codex
BOSSRAID_MODEL_PROVIDER=openai

# On Phala CVM:
# BOSSRAID_TEE_SOCKET_PATH=/var/run/dstack.sock
# BOSSRAID_PROVIDER_PRIVACY_FEATURES=tee_attested,signed_outputs,no_data_retention
