# Claude Code agent-harness worker (Anthropic chat completions + tools)
# Branded claude_code: Boss Raid tool loop over Claude models — not a shell-out to Claude CLI.
# Run on platform Phala (or local) as a Boss Raid HTTP provider.

BOSSRAID_PROVIDER_ID=harness-claude-code-fresh
BOSSRAID_PROVIDER_NAME=Claude Code harness (fresh)
BOSSRAID_PROVIDER_TOKEN=replace-with-provider-token
BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8787
PORT=9013

BOSSRAID_HARNESS_MODE=claude_code
BOSSRAID_HARNESS_SKILLS=
# BOSSRAID_HARNESS_IMAGE_DIGEST=sha256:...
# Specialized: BOSSRAID_HARNESS_IMAGE_ALLOWLIST=sha256:...
# BOSSRAID_HARNESS_REQUIRE_IMAGE_ALLOWLIST=1
# Purchase type for buyer filters: api_key | plan_or_cli | unknown
# BOSSRAID_HARNESS_CREDENTIAL_CLASS=plan_or_cli
# Native Claude Agent SDK / claude CLI (default remains openai_tools over Anthropic API)
# BOSSRAID_HARNESS_RUNTIME_BACKEND=auto
# BOSSRAID_HARNESS_NATIVE_SDK=0
# BOSSRAID_CLAUDE_CLI_BIN=claude
BOSSRAID_HARNESS_MAX_STEPS=12

BOSSRAID_MODEL_API_BASE=https://api.anthropic.com/v1
BOSSRAID_MODEL_API_KEY=sk-ant-...
# Upstream Anthropic model id (not the Boss Raid catalog id anthropic/claude-sonnet-4-5)
BOSSRAID_MODEL=claude-sonnet-4-5
BOSSRAID_AGENT_FRAMEWORK=claude_code
BOSSRAID_MODEL_PROVIDER=anthropic

# On Phala CVM:
# BOSSRAID_TEE_SOCKET_PATH=/var/run/dstack.sock
# BOSSRAID_PROVIDER_PRIVACY_FEATURES=tee_attested,signed_outputs,no_data_retention
