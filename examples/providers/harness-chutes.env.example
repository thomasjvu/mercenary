# Chutes.ai agent-harness worker (OpenAI-compatible tools on llm.chutes.ai)
# Use a Chutes API key (cpk_...). TEE models report confidential_compute on catalog.

BOSSRAID_PROVIDER_ID=harness-chutes-fresh
BOSSRAID_PROVIDER_NAME=Chutes harness (fresh)
BOSSRAID_PROVIDER_TOKEN=replace-with-provider-token
BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8787
PORT=9014

BOSSRAID_HARNESS_MODE=chutes
BOSSRAID_HARNESS_SKILLS=
# BOSSRAID_HARNESS_IMAGE_DIGEST=sha256:...
BOSSRAID_HARNESS_MAX_STEPS=12

# OpenAI-compatible LLM gateway (default when mode=chutes)
BOSSRAID_MODEL_API_BASE=https://llm.chutes.ai/v1
BOSSRAID_MODEL_API_KEY=cpk_...
BOSSRAID_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
BOSSRAID_AGENT_FRAMEWORK=chutes
BOSSRAID_MODEL_PROVIDER=chutes

# Optional override:
# BOSSRAID_CHUTES_LLM_BASE=https://llm.chutes.ai/v1

# On Phala CVM:
# BOSSRAID_TEE_SOCKET_PATH=/var/run/dstack.sock
# BOSSRAID_PROVIDER_PRIVACY_FEATURES=tee_attested,signed_outputs,no_data_retention
