# Grok agent-harness worker (xAI chat completions + tools)
# Run on platform Phala (or local) as a Boss Raid HTTP provider.

BOSSRAID_PROVIDER_ID=harness-grok-fresh
BOSSRAID_PROVIDER_NAME=Grok harness (fresh)
BOSSRAID_PROVIDER_TOKEN=replace-with-provider-token
BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8787
PORT=9012

BOSSRAID_HARNESS_MODE=grok
BOSSRAID_HARNESS_SKILLS=
# BOSSRAID_HARNESS_IMAGE_DIGEST=sha256:...
# Specialized: BOSSRAID_HARNESS_IMAGE_ALLOWLIST=sha256:...
# Purchase type for buyer filters (seller-declared): api_key | plan_or_cli | unknown
# Use plan_or_cli when powering the worker with Grok Build CLI OAuth / subscription.
# BOSSRAID_HARNESS_CREDENTIAL_CLASS=plan_or_cli
# Optional profile alias version (seller-declared, not vendor-verified)
# BOSSRAID_HARNESS_RUNTIME_VERSION=4.5
# Grok uses openai_tools against api.x.ai (no separate native agent SDK)
BOSSRAID_HARNESS_MAX_STEPS=12

BOSSRAID_MODEL_API_BASE=https://api.x.ai/v1
BOSSRAID_MODEL_API_KEY=xai-...
BOSSRAID_MODEL=grok-4.5
BOSSRAID_AGENT_FRAMEWORK=grok
BOSSRAID_MODEL_PROVIDER=xai

# On Phala CVM:
# BOSSRAID_TEE_SOCKET_PATH=/var/run/dstack.sock
# BOSSRAID_PROVIDER_PRIVACY_FEATURES=tee_attested,signed_outputs,no_data_retention
