{
  "name": "boss-raid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "acp-seller:docker:build": "node scripts/build-acp-seller-image.mjs",
    "acp-seller:env:export": "node scripts/export-acp-seller-env.mjs",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "node scripts/dev-stack.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:evaluator": "pnpm --filter @bossraid/evaluator dev",
    "dev:mcp": "node scripts/dev-mcp.mjs",
    "dev:orchestrator": "pnpm --filter @bossraid/orchestrator dev",
    "dev:ops": "pnpm --filter @bossraid/ops dev",
    "dev:provider": "pnpm --filter @bossraid/provider-agent dev",
    "dev:providers": "node scripts/dev-providers.mjs",
    "dev:web": "pnpm --filter @bossraid/web dev",
    "deploy:web:cloudflare": "node scripts/deploy-web-cloudflare.mjs",
    "mercenary:rehearse": "node scripts/mercenary-rehearse.mjs",
    "sync:inference-catalog": "node scripts/sync-inference-catalog.mjs",
    "sync:docs-routes": "node scripts/sync-docs-web-routes.mjs",
    "audit:production-env": "node scripts/audit-production-deploy-env.mjs",
    "dev:docs": "pnpm --filter @bossraid/docs dev",
    "build:docs": "pnpm --filter @bossraid/docs build",
    "papers:sync-upstream": "node scripts/papers-sync-upstream.mjs",
    "papers:sync-downstream": "node scripts/papers-sync-downstream.mjs",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:down": "node scripts/docker-compose.mjs down",
    "docker:up": "node scripts/docker-compose.mjs up --build",
    "eigencompute:build": "docker build --platform linux/amd64 -f Dockerfile.eigencompute -t bossraid-eigencompute:local .",
    "eigencompute:build-job": "docker build --platform linux/amd64 -f Dockerfile.eigencompute --target evaluator-job -t bossraid-evaluator-job:eigencompute-local .",
    "export:legal-character": "node scripts/export-legal-character-video.mjs",
    "generate:legal-character": "node .private/demo-video/scripts/venice-legal-character.mjs --regen-image",
    "generate:pfp": "node .private/demo-video/scripts/venice-pfp.mjs",
    "generate:landing-hero": "node .private/demo-video/scripts/venice-landing-hero.mjs",
    "sync:oc-references": "node .private/demo-video/scripts/sync-oc-references.mjs",
    "export:proof-bundle": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx scripts/export-proof-bundle.ts",
    "game-raid:build-payload": "node scripts/build-game-raid-payload.mjs",
    "serve:gateway": "node scripts/serve-gateway.mjs",
    "test:unit": "turbo run test",
    "test:evaluator:e2e": "node scripts/test-evaluator-e2e.mjs",
    "test:game-raid:e2e": "node scripts/test-game-raid-e2e.mjs",
    "test:private-game-raid:e2e": "node scripts/test-private-game-raid-e2e.mjs",
    "test:strict-private:e2e": "node scripts/test-strict-private-raid-e2e.mjs",
    "test:mcp:e2e": "pnpm --filter @bossraid/mcp-server test:e2e",
    "test:x402:e2e": "node scripts/test-x402-e2e.mjs",
    "test:x402:mock-facilitator": "node scripts/mock-x402-facilitator.mjs",
    "test:surplus-parity:smoke": "node scripts/test-surplus-parity-smoke.mjs",
    "test:partyquest-bossraid:smoke": "node scripts/test-party-quest-bossraid-smoke.mjs",
    "verify:attestation": "node scripts/verify-attestation.mjs",
    "settle:raid": "pnpm --filter @bossraid/orchestrator settle",
    "generate:settlement-keys": "node scripts/generate-settlement-keys.mjs",
    "bootstrap:settlement": "node scripts/bootstrap-settlement.mjs",
    "deploy:contracts": "pnpm build && pnpm --filter @bossraid/contracts run deploy",
    "bootstrap:settlement-env": "pnpm build && pnpm --filter @bossraid/contracts run bootstrap:settlement-env",
    "bootstrap:onchain": "pnpm build && pnpm --filter @bossraid/contracts run bootstrap:onchain",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infisical:phala:check": "node scripts/infisical-phala-secrets.mjs check",
    "infisical:phala:pull": "node scripts/infisical-phala-secrets.mjs pull",
    "infisical:phala:push": "node scripts/infisical-phala-secrets.mjs push",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"**/*.{ts,tsx}\" --max-warnings=0",
    "phala:secrets:check": "node scripts/phala-secrets-preflight.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@bossraid/constants": "workspace:^0.1.0",
    "@bossraid/logger": "workspace:^0.1.0",
    "@bossraid/validator": "workspace:^0.1.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@payai/facilitator": "^2.3.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@x402/evm": "^2.15.0",
    "@x402/fetch": "^2.15.0",
    "eslint": "^10.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.1",
    "viem": "^2.47.5"
  },
  "dependencies": {
    "@x402/core": "^2.15.0"
  }
}
