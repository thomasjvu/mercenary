BOSSRAID_ADMIN_TOKEN=replace-with-long-random-admin-token
BOSSRAID_EVAL_SANDBOX_TOKEN=replace-with-long-random-evaluator-token
BOSSRAID_MODEL_API_KEY=replace-with-model-provider-key
BOSSRAID_MODEL=gpt-4.1-mini
# Optional public gateway tuning
# BOSSRAID_PUBLIC_RATE_LIMIT_MAX=60
# BOSSRAID_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# BOSSRAID_OPS_SESSION_RATE_LIMIT_MAX=10
# BOSSRAID_OPS_SESSION_RATE_LIMIT_WINDOW_MS=300000
# BOSSRAID_PROVIDER_HEALTH_TIMEOUT_MS=5000
# Provider worker auth must stay enabled in unattended deploys.
# The shipped EigenCompute supervisor maps these provider-specific bearer tokens
# into the worker ingress and callback auth env at runtime.
# Do not ship BOSSRAID_ALLOW_INSECURE_PROVIDER_AUTH=1.
BOSSRAID_PROVIDER_A_TOKEN=replace-with-provider-a-token
BOSSRAID_PROVIDER_B_TOKEN=replace-with-provider-b-token
BOSSRAID_PROVIDER_C_TOKEN=replace-with-provider-c-token
# Optional. EigenCompute injects the enclave-bound app mnemonic at runtime.
# Set a local test mnemonic only if you want to smoke the attested runtime
# route outside EigenCompute.
# MNEMONIC=test test test test test test test test test test test junk
# Optional local runtime overrides
# PORT=8080
# BOSSRAID_API_PORT=8787
# BOSSRAID_EVAL_PORT=8790
# BOSSRAID_SQLITE_FILE=/data/bossraid-state.sqlite
# BOSSRAID_PROVIDERS_FILE=/app/examples/inference-marketplace-providers.json
# Optional demo agents: copy examples/demo-agents.providers.eigencompute.json.example into temp/
# Optional remote-provider overrides when the control plane stays on EigenCompute
# and the provider fleet runs elsewhere, such as a Phala CVM.
# BOSSRAID_PROVIDER_A_ENDPOINT=https://<phala-app-id>-9001.<phala-gateway-domain>
# BOSSRAID_PROVIDER_B_ENDPOINT=https://<phala-app-id>-9002.<phala-gateway-domain>
# BOSSRAID_PROVIDER_C_ENDPOINT=https://<phala-app-id>-9003.<phala-gateway-domain>
# BOSSRAID_EVAL_JOB_ISOLATION=process
# BOSSRAID_EVAL_JOB_CONTAINER_IMAGE=bossraid-evaluator-job:eigencompute-local
# BOSSRAID_EVAL_DOCKER_SOCKET_PATH=/var/run/docker.sock
# BOSSRAID_EVAL_JOB_TIMEOUT_MS=45000
# BOSSRAID_EVAL_MAX_CONCURRENT_JOBS=2
# Optional local HMAC smoke for rehearsals only.
# Do not ship this in a public unattended deployment.
# BOSSRAID_X402_VERIFY_HMAC_SECRET=local-dev-only
# BOSSRAID_X402_PAY_TO=0x6170304BC32c790016085647C050194e7eEc447f
# Optional public wallet-payment env. Public write routes are paid by default.
# Set BOSSRAID_X402_ENABLED=false only if you intentionally want unpaid private ingress.
# Leave BOSSRAID_X402_VERIFY_HMAC_SECRET unset on the public deploy.
# BOSSRAID_X402_NETWORK=eip155:84532
# BOSSRAID_X402_ASSET=usdc
# BOSSRAID_X402_RAID_SURCHARGE_USD=0.01
# BOSSRAID_X402_CHAT_SURCHARGE_USD=0.002
# BOSSRAID_X402_RESOURCE_BASE_URL=https://<public-host>/api
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=
# Optional Base mainnet cutover after Sepolia is green.
# BOSSRAID_X402_NETWORK=eip155:8453
# BOSSRAID_X402_CHAT_SURCHARGE_USD=0.01
