BOSSRAID_IMAGE=ghcr.io/your-org/boss-raid:latest
BOSSRAID_EVALUATOR_IMAGE=ghcr.io/your-org/boss-raid-evaluator:latest
BOSSRAID_EVAL_JOB_CONTAINER_IMAGE=ghcr.io/your-org/boss-raid-evaluator-job:latest
BOSSRAID_PROVIDERS_FILE=/app/examples/game-raid/providers.compose.json
BOSSRAID_ADMIN_TOKEN=replace-with-long-random-admin-token
BOSSRAID_REGISTRY_TOKEN=replace-with-long-random-registry-token
BOSSRAID_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key
BOSSRAID_SECRET_ENCRYPTION_KEY_ID=phala-2026-05
# Optional comma-separated old keys used only while rotating persisted state.
# BOSSRAID_SECRET_ENCRYPTION_PREVIOUS_KEYS=
BOSSRAID_TEE_SOCKET_PATH=/var/run/tappd.sock
BOSSRAID_EVAL_SANDBOX_TOKEN=replace-with-long-random-evaluator-token
# Optional Phala root SSH key. Set this before deploy if you want `phala ssh`
# or direct SSH recovery access to the CVM.
# DSTACK_ROOT_PUBLIC_KEY=ssh-ed25519 AAAA...
# Optional remote timing overrides. `deploy/phala/docker-compose.yml` forwards
# these into the API container, and `BOSSRAID_INVITE_ACCEPT_MS` also bounds the
# API-side HTTP invite request timeout to providers.
# BOSSRAID_INVITE_ACCEPT_MS=20000
# BOSSRAID_FIRST_HEARTBEAT_MS=20000
# BOSSRAID_HEARTBEAT_STALE_MS=30000
# BOSSRAID_HARD_EXECUTION_MS=45000
# BOSSRAID_RAID_ABSOLUTE_MS=60000
# BOSSRAID_PROVIDER_FRESH_MS=60000
# Optional socket overrides. The shipped compose file defaults to `socket`
# mode and uses `/socket/evaluator.sock`.
# BOSSRAID_EVAL_SANDBOX_MODE=socket
# BOSSRAID_EVAL_SANDBOX_SOCKET=/socket/evaluator.sock
# BOSSRAID_EVAL_SOCKET_PATH=/socket/evaluator.sock
# Optional disposable job-container isolation. The Phala compose file defaults
# the evaluator to per-job container execution using `BOSSRAID_EVAL_JOB_CONTAINER_IMAGE`.
# BOSSRAID_EVAL_JOB_ISOLATION=container
# BOSSRAID_EVAL_DOCKER_SOCKET_PATH=/var/run/docker.sock
# BOSSRAID_DOCKER_SOCKET_SOURCE=/var/run/docker.sock
# BOSSRAID_DOCKER_SOCKET_GID=0
BOSSRAID_MODEL_API_KEY=replace-with-fallback-model-provider-key
BOSSRAID_MODEL=gpt-4.1-mini
# Mercenary manifest and proof env. Fill these with the real Mercenary
# registration output when you have it.
# BOSSRAID_ERC8004_AGENT_ID=
# BOSSRAID_ERC8004_OPERATOR_WALLET=
# BOSSRAID_ERC8004_REGISTRATION_TX=
# BOSSRAID_ERC8004_IDENTITY_REGISTRY=
# BOSSRAID_ERC8004_REPUTATION_REGISTRY=
# BOSSRAID_ERC8004_VALIDATION_REGISTRY=
# BOSSRAID_ERC8004_VALIDATION_TXS=
# BOSSRAID_ERC8004_LAST_VERIFIED_AT=
# BOSSRAID_ERC8004_VERIFY=true
# Provider worker auth must stay enabled in unattended deploys.
# The shipped Phala compose path maps these provider-specific bearer tokens into
# the worker ingress and callback auth env at runtime.
BOSSRAID_PROVIDER_A_TOKEN=replace-with-provider-a-token
BOSSRAID_PROVIDER_B_TOKEN=replace-with-provider-b-token
BOSSRAID_PROVIDER_C_TOKEN=replace-with-provider-c-token
# Game-demo provider mapping for the Gamma, Riko, and Dottie lane.
BOSSRAID_PROVIDER_A_ID=unity-specialist-a
BOSSRAID_PROVIDER_A_NAME=Dottie
BOSSRAID_PROVIDER_A_MODE=pixel_art
BOSSRAID_PROVIDER_A_INSTRUCTIONS=Specialize in pixel-art asset packs, spritesheets, UI frames, and compact Game Boy-style palettes.
BOSSRAID_PROVIDER_A_MODEL_API_KEY=replace-with-dottie-venice-key
BOSSRAID_PROVIDER_A_MODEL_API_BASE=https://api.venice.ai/api/v1
BOSSRAID_PROVIDER_A_MODEL=minimax-m27
BOSSRAID_PROVIDER_B_ID=minimal-diff-hunter
BOSSRAID_PROVIDER_B_NAME=Riko
BOSSRAID_PROVIDER_B_MODE=remotion
BOSSRAID_PROVIDER_B_INSTRUCTIONS=Specialize in teaser trailers, launch copy, storyboard beats, and Remotion-ready promo bundles.
BOSSRAID_PROVIDER_B_MODEL_API_KEY=replace-with-riko-venice-key
BOSSRAID_PROVIDER_B_MODEL_API_BASE=https://api.venice.ai/api/v1
BOSSRAID_PROVIDER_B_MODEL=minimax-m27
BOSSRAID_PROVIDER_C_ID=regression-averse-maintainer
BOSSRAID_PROVIDER_C_NAME=Gamma
BOSSRAID_PROVIDER_C_MODE=gbstudio
BOSSRAID_PROVIDER_C_INSTRUCTIONS=Specialize in GB Studio gameplay scaffolds, room logic, and minimal repo patches that align to one coherent game hook.
BOSSRAID_PROVIDER_C_MODEL_API_KEY=replace-with-gamma-venice-key
BOSSRAID_PROVIDER_C_MODEL_API_BASE=https://api.venice.ai/api/v1
BOSSRAID_PROVIDER_C_MODEL=minimax-m27
# Optional evaluator abuse limits
# BOSSRAID_EVAL_JOB_TIMEOUT_MS=45000
# BOSSRAID_EVAL_JOB_CONTAINER_TMPFS_MB=512
# BOSSRAID_EVAL_JOB_CONTAINER_MEMORY_MB=1024
# BOSSRAID_EVAL_JOB_CONTAINER_CPUS=1
# BOSSRAID_EVAL_JOB_CONTAINER_PIDS_LIMIT=256
# BOSSRAID_EVAL_MAX_CONCURRENT_JOBS=2
# BOSSRAID_EVAL_MAX_FILES=256
# BOSSRAID_EVAL_MAX_TOTAL_BYTES=1048576
# BOSSRAID_EVAL_MAX_FILE_BYTES=262144
# BOSSRAID_EVAL_MAX_PATH_LENGTH=240
# Optional paid-route env. Public write routes are paid by default.
# Set BOSSRAID_X402_ENABLED=false only if you intentionally want unpaid private ingress.
# Optional free hosted-demo lane. Keep POST /v1/raid paid, and enable this only
# if you want `/demo` to launch through POST /v1/demo/raid.
# BOSSRAID_DEMO_ROUTE_ENABLED=true
# BOSSRAID_DEMO_TOKEN=replace-with-long-random-demo-token
# BOSSRAID_DEMO_PROXY_TOKEN=replace-with-the-same-demo-token
# BOSSRAID_X402_PAY_TO=0x3bd7717267c6A2D29F07Da83D59155Ac6cD80A69
# BOSSRAID_X402_NETWORK=eip155:84532
# BOSSRAID_X402_ASSET=usdc
# BOSSRAID_X402_RESOURCE_BASE_URL=https://<public-host>/api
# BOSSRAID_X402_VERIFY_HMAC_SECRET=
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=
# ERC-8183 onchain settlement. Enable after deploying contracts via ACP or manually.
# BOSSRAID_SETTLEMENT_MODE=file
# BOSSRAID_RPC_URL=https://mainnet.base.org
# BOSSRAID_CHAIN_ID=8453
# BOSSRAID_REGISTRY_ADDRESS=
# BOSSRAID_ESCROW_ADDRESS=
# BOSSRAID_TOKEN_ADDRESS=0x833589fCD6eDb6B08d2E354A1d9441D5b2AaE4a5
# BOSSRAID_CLIENT_PRIVATE_KEY=
# BOSSRAID_EVALUATOR_ADDRESS=
# BOSSRAID_PROVIDER_ADDRESS_MAP_JSON='{"regression-averse-maintainer":"0x...","minimal-diff-hunter":"0x...","unity-specialist-a":"0x..."}'
# BOSSRAID_SETTLEMENT_FUND_JOBS=false
# BOSSRAID_SETTLEMENT_REQUIRE_TERMINAL_JOBS=false
# BOSSRAID_SETTLEMENT_EVALUATOR_PRIVATE_KEY=
# BOSSRAID_SETTLEMENT_PROVIDER_PRIVATE_KEYS_JSON='{"regression-averse-maintainer":"0x...","minimal-diff-hunter":"0x...","unity-specialist-a":"0x..."}'
