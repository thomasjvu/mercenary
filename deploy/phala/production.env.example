# Production configuration reference for Boss Raid on Phala
# Copy to local tier files (gitignored) and bootstrap the assembled deploy env:
#   cp deploy/phala/production.env.example deploy/phala/secrets.core.env
#   pnpm bootstrap:phala:env
# DO NOT commit real keys or secrets.

# =============================================================================
# INFISICAL CORE TIER  -> prod:/bossraid/phala/core  (14 secrets)
# =============================================================================

BOSSRAID_IMAGE=ghcr.io/your-org/bossraid:latest
BOSSRAID_EVALUATOR_IMAGE=ghcr.io/your-org/bossraid-evaluator:latest
BOSSRAID_EVAL_JOB_CONTAINER_IMAGE=ghcr.io/your-org/bossraid-evaluator-job:latest

BOSSRAID_ADMIN_TOKEN=<replace-with-long-random-admin-token>
BOSSRAID_REGISTRY_TOKEN=<replace-with-long-random-registry-token>
BOSSRAID_SECRET_ENCRYPTION_KEY=<replace-with-32-byte-base64-or-64-char-hex-key>
BOSSRAID_EVAL_SANDBOX_TOKEN=<replace-with-long-random-evaluator-token>

BOSSRAID_PROVIDER_A_TOKEN=<replace-with-long-random-provider-token>
BOSSRAID_PROVIDER_B_TOKEN=<replace-with-long-random-provider-token>
BOSSRAID_PROVIDER_C_TOKEN=<replace-with-long-random-provider-token>

# Shared upstream inference key for all in-CVM providers (Venice by default).
BOSSRAID_VENICE_API_KEY=<replace-with-venice-or-compatible-upstream-key>

BOSSRAID_X402_PAY_TO=0x3bd7717267c6A2D29F07Da83D59155Ac6cD80A69
PAYAI_API_KEY_ID=<replace-with-payai-key-id>
PAYAI_API_KEY_SECRET=<replace-with-payai-key-secret>

# =============================================================================
# INFISICAL ONCHAIN OVERLAY  -> prod:/bossraid/phala/onchain  (optional until launch)
# =============================================================================

BOSSRAID_SETTLEMENT_MODE=onchain
BOSSRAID_RPC_URL=https://mainnet.base.org
BOSSRAID_CHAIN_ID=8453
BOSSRAID_REGISTRY_ADDRESS=<deployed-raid-registry-address>
BOSSRAID_ESCROW_ADDRESS=<deployed-bossjob-escrow-address>
BOSSRAID_BOUNTY_ESCROW_ADDRESS=<deployed-bossbounty-escrow-address>
BOSSRAID_TOKEN_ADDRESS=0x833589fCD6eDb6B08d2E354A1d9441D5b2AaE4a5
BOSSRAID_CLIENT_PRIVATE_KEY=<wallet-with-usdc-for-gas-and-escrow-funding>
BOSSRAID_EVALUATOR_ADDRESS=<evaluator-wallet-address>
BOSSRAID_SETTLEMENT_EVALUATOR_PRIVATE_KEY=<evaluator-signer-private-key>
BOSSRAID_PROVIDER_ADDRESS_MAP_JSON=<provider-id-to-address-map-json>
BOSSRAID_SETTLEMENT_PROVIDER_PRIVATE_KEYS_JSON=<provider-id-to-private-key-json>

# =============================================================================
# ERC-8004 IDENTITY (optional onchain overlay fields)
# =============================================================================

BOSSRAID_ERC8004_AGENT_ID=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_OPERATOR_WALLET=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_REGISTRATION_TX=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_IDENTITY_REGISTRY=<from-ACP-capture-sheet>

# =============================================================================
# ASSEMBLED DEPLOY DEFAULTS (not stored in Infisical)
# Bootstrap writes these into deploy/phala/.env from code defaults.
# =============================================================================
# - provider id/name/mode/instructions
# - x402 network/asset/facilitator defaults
# - public + buyer rate limits
# - operator terms / incident ack flags
# - BOSSRAID_PROVIDERS_FILE, BOSSRAID_TEE_SOCKET_PATH