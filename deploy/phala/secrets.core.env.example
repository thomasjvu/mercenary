# Core tier -> prod:/bossraid/phala/core (15 Infisical secrets)
# Copy to the gitignored local file and fill real values:
#   cp deploy/phala/secrets.core.env.example deploy/phala/secrets.core.env
# Then bootstrap the assembled deploy env:
#   pnpm bossraid bootstrap:phala:env
# DO NOT commit deploy/phala/secrets.core.env

MNEMONIC=<replace-with-bip39-mnemonic-for-runtime-signing>
BOSSRAID_IMAGE=ghcr.io/your-org/bossraid:latest
BOSSRAID_EVALUATOR_IMAGE=ghcr.io/your-org/bossraid-evaluator:latest
BOSSRAID_EVAL_JOB_CONTAINER_IMAGE=ghcr.io/your-org/bossraid-evaluator-job:latest

BOSSRAID_ADMIN_TOKEN=<replace-with-long-random-admin-token>
BOSSRAID_REGISTRY_TOKEN=<replace-with-long-random-registry-token>
BOSSRAID_SECRET_ENCRYPTION_KEY=<replace-with-32-byte-base64-or-64-char-hex-key>
BOSSRAID_EVAL_SANDBOX_TOKEN=<replace-with-long-random-evaluator-token>

BOSSRAID_PROVIDER_A_TOKEN=<replace-with-long-random-provider-token>
BOSSRAID_PROVIDER_B_TOKEN=<replace-with-long-random-provider-token>
BOSSRAID_PROVIDER_C_TOKEN=<replace-with-long-random-provider-token>

# Shared upstream inference key for all in-CVM providers (Venice by default).
BOSSRAID_VENICE_API_KEY=<replace-with-venice-or-compatible-upstream-key>

BOSSRAID_X402_PAY_TO=0x3bd7717267c6A2D29F07Da83D59155Ac6cD80A69
PAYAI_API_KEY_ID=<replace-with-payai-key-id>
PAYAI_API_KEY_SECRET=<replace-with-payai-key-secret>