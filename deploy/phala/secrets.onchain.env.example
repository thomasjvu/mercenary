# Onchain overlay -> prod:/bossraid/phala/onchain (optional until launch)
# Copy when staging settlement keys:
#   cp deploy/phala/secrets.onchain.env.example deploy/phala/secrets.onchain.env
# Populate after `pnpm bossraid generate:settlement-keys` and `pnpm bossraid bootstrap:settlement`.
# DO NOT commit deploy/phala/secrets.onchain.env
#
# Settlement rail: Robinhood Chain (4663) + USDG.

BOSSRAID_SETTLEMENT_MODE=onchain
BOSSRAID_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BOSSRAID_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BOSSRAID_CHAIN_ID=4663
BOSSRAID_REGISTRY_ADDRESS=<deployed-raid-registry-address>
BOSSRAID_ESCROW_ADDRESS=<deployed-bossjob-escrow-address>
BOSSRAID_BOUNTY_ESCROW_ADDRESS=<deployed-bossbounty-escrow-address>
BOSSRAID_TOKEN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
BOSSRAID_CLIENT_PRIVATE_KEY=<wallet-with-usdg-for-gas-and-escrow-funding>
# Marketplace seller cash-out (ledger → USDG flush). Prefer dedicated treasury key;
# falls back to BOSSRAID_CLIENT_PRIVATE_KEY if unset.
BOSSRAID_SETTLEMENT_TREASURY_KEY=<hot-wallet-with-usdg-for-seller-payouts>
BOSSRAID_SETTLEMENT_MIN_PAYOUT_USD=1
BOSSRAID_EVALUATOR_ADDRESS=<evaluator-wallet-address>
BOSSRAID_SETTLEMENT_EVALUATOR_PRIVATE_KEY=<evaluator-signer-private-key>
BOSSRAID_PROVIDER_ADDRESS_MAP_JSON=<provider-id-to-address-map-json>
BOSSRAID_SETTLEMENT_PROVIDER_PRIVATE_KEYS_JSON=<provider-id-to-private-key-json>

# ERC-8004 identity (optional onchain overlay fields)
BOSSRAID_ERC8004_AGENT_ID=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_OPERATOR_WALLET=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_REGISTRATION_TX=<from-ACP-capture-sheet>
BOSSRAID_ERC8004_IDENTITY_REGISTRY=<from-ACP-capture-sheet>
