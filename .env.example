# Boss Raid local development
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Full variable reference: docs/reference/env.md

# --- Core runtime ---

BOSSRAID_STORAGE_BACKEND=sqlite
BOSSRAID_SQLITE_FILE=./temp/bossraid-state.sqlite
BOSSRAID_PROVIDERS_FILE=./examples/providers.http.json
BOSSRAID_PROVIDER_FRESH_MS=60000

# API listener (default 8787)
PORT=8787
# BOSSRAID_API_HOST=127.0.0.1

# Auth tokens for local admin/registry flows
BOSSRAID_ADMIN_TOKEN=change-me-admin-token
BOSSRAID_REGISTRY_TOKEN=change-me-registry-token

# Optional secret encryption for persisted auth material
# BOSSRAID_SECRET_ENCRYPTION_KEY=change-me-high-entropy-secret

# --- Web / MCP dev proxies ---

VITE_BOSSRAID_API_BASE=http://127.0.0.1:8787
# BOSSRAID_API_BASE=http://127.0.0.1:8787

# --- Provider workers (pnpm dev:providers) ---

# Shared model credentials for all local providers
# BOSSRAID_MODEL_API_KEY=sk-your-model-key
# BOSSRAID_MODEL=gpt-5.5
# BOSSRAID_MODEL_API_BASE=https://api.openai.com/v1

# Per-provider Venice keys (alternative to shared model env above)
# VENICE_API_KEY_DOTTIE=
# VENICE_API_KEY_RIKO=
# VENICE_API_KEY_GAMMA=
# BOSSRAID_VENICE_API_BASE=https://api.venice.ai/api/v1
# BOSSRAID_VENICE_MODEL=minimax-m27

# Local stub responses when no model key is configured (auto-enabled by dev:providers)
# BOSSRAID_PROVIDER_STUB_MODE=true

# Point provider callbacks at the API when not on default port 8787
# BOSSRAID_CALLBACK_BASE=http://127.0.0.1:8788

# Local-only insecure provider auth for examples/providers.http.json
# BOSSRAID_ALLOW_INSECURE_PROVIDER_AUTH=1

# --- x402 payments ---

# Disable paid-route challenges for local smoke without a facilitator
BOSSRAID_X402_ENABLED=false

# Live facilitator-backed payments (uncomment and set a real receiving wallet)
# BOSSRAID_X402_ENABLED=true
# BOSSRAID_X402_FACILITATOR_URL=https://facilitator.payai.network
# BOSSRAID_X402_NETWORK=eip155:84532
# BOSSRAID_X402_ASSET=usdc
# BOSSRAID_X402_PAY_TO=0xYourReceivingAddress
# Flat surcharges added on top of the reserved seller budget (not model price)
# BOSSRAID_X402_RAID_SURCHARGE_USD=0.01
# BOSSRAID_X402_CHAT_SURCHARGE_USD=0.002
# BOSSRAID_X402_RESOURCE_BASE_URL=http://127.0.0.1:8787

# PayAI merchant credentials (required for live x402 verify/settle)
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=

# Coinbase CDP fallback facilitator (optional)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# BOSSRAID_X402_FACILITATOR_FALLBACK=true

# --- x402 / smoke test helpers ---

# BOSSRAID_X402_BUYER_PRIVATE_KEY=0xYourFundedTestWalletPrivateKey
# EVM_PRIVATE_KEY=0xYourFundedTestWalletPrivateKey
# BOSSRAID_X402_E2E_API_BASE=http://127.0.0.1:8787
# BOSSRAID_X402_E2E_ROUTE=inference
# BOSSRAID_X402_E2E_MODE=mock
# BOSSRAID_API_BASE=http://127.0.0.1:8788
# BOSSRAID_SMOKE_TIMEOUT_MS=120000

# Mock facilitator for local x402 e2e (pnpm test:x402:mock-facilitator)
# BOSSRAID_MOCK_FACILITATOR_HOST=127.0.0.1
# BOSSRAID_MOCK_FACILITATOR_PORT=8791

# --- Buyer marketplace defaults ---

# BOSSRAID_CHAT_DEFAULT_MAX_TOTAL_COST=15
# BOSSRAID_BUYER_KEY_DEFAULT_SPEND_LIMIT_USD=25
# BOSSRAID_BUYER_MAX_REQUEST_BUDGET_USD=50

# --- Settlement (optional local onchain proof) ---

# BOSSRAID_SETTLEMENT_MODE=off
# BOSSRAID_RPC_URL=
# BOSSRAID_CHAIN_ID=84532
# BOSSRAID_REGISTRY_ADDRESS=
# BOSSRAID_ESCROW_ADDRESS=
# BOSSRAID_TOKEN_ADDRESS=
# BOSSRAID_CLIENT_PRIVATE_KEY=
# BOSSRAID_EVALUATOR_ADDRESS=

# --- Demo route (optional) ---

# BOSSRAID_DEMO_ROUTE_ENABLED=true
# BOSSRAID_DEMO_TOKEN=change-me-demo-token  # required when demo route is enabled

# --- Trusted Mana Core billing (optional) ---

# BOSSRAID_MANA_CORE_URL=
# BOSSRAID_MANA_CORE_KEY=
# BOSSRAID_API_KEY=