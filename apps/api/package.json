{
  "name": "@bossraid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/api/src/index.js",
  "types": "dist/apps/api/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/apps/api/src/index.d.ts",
      "default": "./dist/apps/api/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:all": "node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bossraid/agent-harness": "workspace:*",
    "@bossraid/api-contracts": "workspace:*",
    "@bossraid/constants": "workspace:*",
    "@bossraid/logger": "workspace:*",
    "@bossraid/oneshot-relayer": "workspace:*",
    "@bossraid/openapi-schemas": "workspace:*",
    "@bossraid/orchestrator": "workspace:*",
    "@bossraid/persistence": "workspace:*",
    "@bossraid/persistence-postgres": "workspace:*",
    "@bossraid/privacy-engine": "workspace:*",
    "@bossraid/provider-registry": "workspace:*",
    "@bossraid/provider-sdk": "workspace:*",
    "@bossraid/raid-core": "workspace:*",
    "@bossraid/sandbox-runner": "workspace:*",
    "@bossraid/shared-types": "workspace:*",
    "@bossraid/venice-client": "workspace:*",
    "@fastify/swagger": "^9.7.0",
    "@payai/facilitator": "^2.3.4",
    "fastify": "^5.12.5",
    "viem": "^2.47.5"
  },
  "devDependencies": {
    "@bossraid/test-fixtures": "workspace:*"
  }
}
